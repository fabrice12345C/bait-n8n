    {
      "parameters": {
        "jsCode": "// Builds a short alert for the owner. No secrets: only the workflow name, failed node, error text and the execution link.\nconst x = $input.first().json;\nconst e = x.execution || {}; const w = x.workflow || {};\nconst summary = { workflow: w.name || 'unknown', executionId: e.id || 'unknown', failedNode: e.lastNodeExecuted || 'unknown',\n  error: (e.error && e.error.message) || 'unknown error', url: e.url || '(no execution URL: manual run)', timestamp: new Date().toISOString() };\nconst message = 'BAIT ALERT: a workflow failed\\nWorkflow: ' + summary.workflow + '\\nFailed node: ' + summary.failedNode + '\\nError: ' + String(summary.error).slice(0, 300) + '\\nExecution: ' + summary.url;\nreturn [{ json: { ...summary, message } }];"
      },
      "id": "4ac1301c-5050-457e-8308-b026e1975816",
      "name": "Summarize Failure",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
