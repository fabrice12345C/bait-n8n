# Copy this file to .env and fill in real values. .env is git-ignored and must never be committed.

# Encrypts the credentials n8n stores (Telegram token, OpenRouter key, Postgres password).
# Generate once, e.g. PowerShell: [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 }))
# Keep it: changing it later makes existing credentials unreadable.
N8N_ENCRYPTION_KEY=replace-with-a-long-random-string

# Public HTTPS address that forwards to localhost:5678 (Telegram needs it for the webhook).
# Example with ngrok: ngrok http 5678 --url=https://your-subdomain.ngrok-free.dev
N8N_WEBHOOK_URL=https://your-subdomain.ngrok-free.dev/

# Project database (Postgres container). Only n8n can reach it; no port is opened on the PC.
POSTGRES_DB=bait_demo
POSTGRES_USER=bait_app
POSTGRES_PASSWORD=replace-with-a-strong-password
